GROQ_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Optional comma-separated extras tried after GEMINI_MODEL on 503/overload:
# GEMINI_MODEL_FALLBACKS=gemini-3.5-flash,gemini-2.5-flash

# --- Voice mode (`python main.py --voice`) ---
# GROQ_API_KEY is required for speech-to-text (Whisper via Groq).
# GROQ_STT_MODEL=whisper-large-v3-turbo
# VOICE_SILENCE_MS=900
# VOICE_MIN_SPEECH_MS=320
# VOICE_MAX_UTTERANCE_MS=15000
# VOICE_NOISE_MULTIPLIER=3.0
# VOICE_MIN_THRESHOLD=170.0
